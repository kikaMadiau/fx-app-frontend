# Adresse de l'API Go vue par le navigateur.
# En développement, Vite relaie /api vers http://localhost:8080 (voir vite.config.js) :
# un seul port à ouvrir, y compris derrière un tunnel (VS Code, devtunnels).
# Sans relais, mettre l'adresse complète de l'API, ex. http://localhost:8080
PUBLIC_API_BASE_URL=/api
